{
  "name": "@undefined-labs/inventory",
  "version": "0.0.3",
  "description": "Headless inventory domain library for OpenCore runtime",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undefined-labs/undefined-inventory.git"
  },
  "homepage": "https://github.com/undefined-labs/undefined-inventory#readme",
  "bugs": {
    "url": "https://github.com/undefined-labs/undefined-inventory/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.js"
    },
    "./shared/testing": {
      "types": "./dist/shared/testing/store-conformance.d.ts",
      "import": "./dist/shared/testing/store-conformance.js",
      "require": "./dist/shared/testing/store-conformance.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@open-core/framework": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "vitest": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@citizenfx/server": "2.0.31623-1",
    "@open-core/framework": "^1.1.0",
    "@types/node": "^24.5.2",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.5.2"
}
